{
  "name": "@deepseek-ai/dsh-mcp-settings",
  "description": "Managed MCP server settings for adding MCP servers",
  "version": "1.0.18",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixlucky/dsh-mcp-settings.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./managed": {
      "types": "./vendor/dsh-mcp-client/lib/types/managed.d.ts",
      "default": "./lib/managed.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "settings/**",
    "lib/index.js",
    "lib/managed.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "vendor/dsh-mcp-client/package.json",
    "vendor/dsh-mcp-client/lib/index.js",
    "vendor/dsh-mcp-client/lib/managed.js",
    "vendor/dsh-mcp-client/lib/types-*.js",
    "vendor/dsh-mcp-client/lib/types/connection.js",
    "vendor/dsh-mcp-client/lib/types/index.js",
    "vendor/dsh-mcp-client/lib/types/managed.js",
    "vendor/dsh-mcp-client/lib/types/server-context.js",
    "vendor/dsh-mcp-client/lib/types/status.js",
    "vendor/dsh-mcp-client/lib/types/tools.js",
    "vendor/dsh-mcp-client/lib/types/transport.js",
    "vendor/dsh-mcp-client/lib/types/types.js",
    "vendor/dsh-mcp-client/lib/types/connection.d.ts",
    "vendor/dsh-mcp-client/lib/types/index.d.ts",
    "vendor/dsh-mcp-client/lib/types/managed.d.ts",
    "vendor/dsh-mcp-client/lib/types/server-context.d.ts",
    "vendor/dsh-mcp-client/lib/types/status.d.ts",
    "vendor/dsh-mcp-client/lib/types/tools.d.ts",
    "vendor/dsh-mcp-client/lib/types/transport.d.ts",
    "vendor/dsh-mcp-client/lib/types/types.d.ts",
    "vendor/dsh-mcp-client/lib/typert.host.js",
    "vendor/dsh-mcp-client/lib/typert.host.d.ts",
    "vendor/dsh-mcp-client/lib/typert.remote-client.js",
    "vendor/dsh-mcp-client/lib/typert.remote-client.d.ts",
    "vendor/dsh-mcp-client/locale/*.json"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "file:vendor/dsh-mcp-client"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  }
}
