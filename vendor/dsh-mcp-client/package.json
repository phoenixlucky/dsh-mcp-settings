{
  "name": "@deepseek-ai/dsh-mcp-client",
  "description": "MCP client runtime with a unified managed server list",
  "version": "0.2.2-alpha.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./managed": {
      "types": "./lib/types/managed.d.ts",
      "default": "./lib/types/managed.js"
    },
    "./status": {
      "types": "./lib/types/status.d.ts",
      "default": "./lib/types/status.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-mcp-resources": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-alpha.2 <0.3.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.7-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@modelcontextprotocol/client": "2.2.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-alpha.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-resources": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
