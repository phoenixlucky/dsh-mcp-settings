node_modules/
**/*.tsbuildinfo

# Generated package archives and local backups
*.tgz
backups/

# Local agent records (not published, not tracked)
AGENTS.md
MEMORY.md

# Audit records written by `node scripts/mcp-audit.mjs --json`
.audit/

# Staging copy used by `node scripts/pack.mjs`
.pack-staging/

# Scratch directory for one-off probes (never published)
.tmp/

# Generated card previews and the headless browser profiles used to shoot them
docs/preview/
.preview-chrome*/
